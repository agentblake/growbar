{
  "name": "growbar",
  "version": "0.19.2",
  "description": "A direct Bluetooth macOS scheduler, 318-gel color library, native effects designer, and 4–32-section ambience controller for the Aputure INFINIBAR PB12",
  "main": "src/main.js",
  "type": "commonjs",
  "author": "GrowBar contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:mac": "electron-builder --mac zip --x64 --arm64",
    "dist:mac": "npm test && npm run build:mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.growbar.app",
    "productName": "GrowBar",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "native/GrowBarBluetoothBridge.app",
        "to": "native/GrowBarBluetoothBridge.app"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "target": [
        "zip"
      ],
      "artifactName": "GrowBar-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "GrowBar uses Bluetooth to directly control the PB12 imported from your local amaran Desktop database."
      }
    }
  }
}
